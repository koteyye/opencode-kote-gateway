{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@koteyye/kote-gateway-opencode",
  "version": "0.1.0",
  "description": "Fail-closed Kote Gateway transport plugin for OpenCode",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.3.14",
    "opencode": ">=1.18.5 <=1.18.18"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "audit": "bun run scripts/audit.ts",
    "build": "bun run scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "bun run lint && bun run typecheck && bun test && bun run build && bun run package:smoke",
    "lint": "oxlint src tests scripts",
    "package:smoke": "bun run scripts/package-smoke.ts",
    "test": "bun test",
    "test:integration": "bun test tests/integration",
    "test:opencode": "bun run build && bun run scripts/opencode-smoke.ts 1.18.18",
    "test:unit": "bun test tests/unit tests/contract",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build && bun run package:smoke"
  },
  "dependencies": {
    "@noble/ed25519": "3.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@types/bun": "1.3.14",
    "oxlint": "1.60.0",
    "typescript": "5.8.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.5 <=1.18.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koteyye/kote-gateway-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/koteyye/kote-gateway-opencode/issues"
  },
  "homepage": "https://github.com/koteyye/kote-gateway-opencode#readme",
  "keywords": [
    "opencode",
    "plugin",
    "proxy",
    "gateway",
    "connect"
  ]
}
